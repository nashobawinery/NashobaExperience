# Database Configuration
DATABASE_URL=postgresql://username:password@host:port/database?sslmode=require

# Authentication Configuration
SESSION_SECRET=your-secure-session-secret-here
AUTH_STRATEGY=platform

# For Toast Standard Mode (alternative to platform mode)
# AUTH_STRATEGY=toast_standard
# ADMIN_PASSWORD=your-admin-password-here

# Replit OIDC Mode (alternative authentication)
# AUTH_STRATEGY=replit_oidc
# REPL_ID=your-repl-id
# ISSUER_URL=https://replit.com/oidc

# Object Storage (Google Cloud / Replit Object Storage)
DEFAULT_OBJECT_STORAGE_BUCKET_ID=your-bucket-name
# Optional fallback used by legacy attachment paths
REPLIT_DEFAULT_BUCKET_ID=your-bucket-name
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account-key.json
# Comma-separated storage roots for public media lookups
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket-name/public
# Storage root for private files
PRIVATE_OBJECT_DIR=/your-bucket-name/.private

# Shopify Integration (Admin API)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpat_your_admin_api_access_token
# Optional: override API version if needed (default is 2025-10)
# SHOPIFY_API_VERSION=2025-10
